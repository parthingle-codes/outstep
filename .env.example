# ---------------------------------------------------------------------------
# OutStep backend configuration
# Copy this file to `.env` and adjust the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Which AI provider to use: `ollama` (local development) or `openai`
# (any remote, OpenAI-compatible endpoint).
AI_PROVIDER=ollama

# --- Ollama (local development, fully offline) ------------------------------
# Ollama must be running locally: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
# Any chat model installed in Ollama (`ollama list` to see what you have).
OLLAMA_MODEL=llama3.2

# --- Remote OpenAI-compatible endpoint (deployment) -------------------------
# Works with any service that exposes the OpenAI `/v1/chat/completions` API
# (OpenAI, Groq, Together, OpenRouter, a self-hosted vLLM, etc.).
OPENAI_BASE_URL=https://api.openai.com/v1
# Keep this in `.env` only — it is read by the backend and never sent to the
# browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Server -----------------------------------------------------------------
# Port is provided by the host (Render sets $PORT). Defaults to 8000 locally.
# PORT=8000
# Comma-separated list of allowed CORS origins for the dev Vite server.
CORS_ORIGINS=http://localhost:5173

# Set to `1` to allow returning a clearly-labelled sample mission from
# `/api/sample-mission` (already enabled by default; the sample is never
# presented as AI output).
ALLOW_SAMPLE_MISSION=1
